<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="#070B14">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_streak"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔥 0 HARI STREAK"
            android:textColor="#FB923C"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/widget_rank_lv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="E-RANK • Lv.1"
            android:textColor="#22D3EE"
            android:textStyle="bold"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_hp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="❤️ HP: 100 / 100"
        android:textColor="#F87171"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_daily"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="⚔️ Daily Quest: 0% (Target ≥70%)"
        android:textColor="#94A3B8"
        android:textSize="12sp" />
</LinearLayout>
